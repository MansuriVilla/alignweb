{% comment %}
Performance Metrics Tracked Section
- Dynamic metric tiles using Shopify blocks
- Desktop: 4-column grid layout
- Mobile: Horizontal scroll
{% endcomment %}

<section class="performance-metrics" data-section-id="{{ section.id }}">
  <div class="performance-metrics__background">
    {%- if section.settings.background_image != blank -%}
    {{
    section.settings.background_image
    | image_url: width: 1920
    | image_tag: alt: section.settings.heading, loading: 'lazy'
    }}
    {%- else -%}
    <div style="background: linear-gradient(135deg, #2d5016 0%, #4a7c23 50%, #6b8e23 100%); width: 100%; height: 100%;">
    </div>
    {%- endif -%}
    {% if section.settings.overlaySection %}
    <div class="performance-metrics__overlay"></div>
    {% endif %}
  </div>

  <div class="performance-metrics__container">
    <div class="performance-metrics__header">
      <h2 class="performance-metrics__title">
        {{ section.settings.heading }}
      </h2>
      {%- if section.settings.subheading != blank -%}
      <p class="performance-metrics__subtitle">
        {{ section.settings.subheading }}
      </p>
      {%- endif -%}
    </div>

    <div class="performance-metrics__tiles-wrapper">
      <div class="performance-metrics__tiles-grid">
        {%- for block in section.blocks -%}
        {%- if block.type == 'metric_tile' -%}
        <div class="performance-metrics__tile" {{ block.shopify_attributes }}>
          <span class="performance-metrics__tile-label">
            {{ block.settings.label -}}
            {%- if block.settings.is_special %}*{% endif %}
          </span>
        </div>
        {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    {%- if section.settings.product_image != blank -%}
    <div class="performance-metrics__product">
      {{
      section.settings.product_image
      | image_url: width: 240
      | image_tag: class: 'performance-metrics__product-image', alt: 'Product Device', loading: 'lazy'
      }}
    </div>
    {%- endif -%}

    {%- if section.settings.disclaimer != blank -%}
    <p class="performance-metrics__disclaimer">
      {{ section.settings.disclaimer }}
    </p>
    {%- endif -%}
  </div>
</section>

<style>
  .performance-metrics {
    position: relative;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(40px, 3.7vw, 70px) 0;
    overflow: hidden;
  }

  .performance-metrics__background {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .performance-metrics__background img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .performance-metrics__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom,
        rgba(0, 0, 0, 0.3) 0%,
        rgba(0, 0, 0, 0.1) 50%,
        rgba(0, 0, 0, 0.4) 100%);
    z-index: 1;
  }

  .performance-metrics__container {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 clamp(16px, 4vw, 40px);
    text-align: center;
  }


  .performance-metrics__header {
    margin-bottom: clamp(24px, 4vw, 40px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 20px;
  }

  .performance-metrics__title {
    font-size: clamp(28px, 5vw, 48px);
    color: #ffffff;
    max-width: 600px;
    width: 100%;
    line-height: 100%;
  }

  .performance-metrics__subtitle {
    font-size: clamp(14px, 2vw, 16px);
    color: rgba(255, 255, 255, 0.9);
    max-width: 500px;
    padding: 0;
    margin: 0 auto;
    line-height: 1.5;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.3);
  }

  /* ===== Tiles Container ===== */
  .performance-metrics__tiles-wrapper {
    position: relative;
    margin-bottom: clamp(20px, 4vw, 40px);
  }

  .performance-metrics__tiles-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(8px, 1.5vw, 16px);

    margin: 0 auto;
  }


  .performance-metrics__tile {
    background: rgba(0, 0, 0, 0.5);
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    backdrop-filter: blur(16.9223px);
    -webkit-backdrop-filter: blur(16.9223px);
    padding-block: 24px;
    padding-inline: 30px;
  }

  .performance-metrics__tile-label {
    font-size: clamp(16px, 1.5vw, 24px);
    font-weight: 700;
    color: #fff;
    text-transform: uppercase;
    white-space: nowrap;
    line-height: 1;
    letter-spacing: 1.6px;
  }


  .performance-metrics__product {
    position: relative;
    display: flex;
    justify-content: center;
    margin: clamp(-60px, -8vw, -80px) auto clamp(16px, 3vw, 24px);
    z-index: 3;
  }

  .performance-metrics__product-image {
    width: clamp(80px, 12vw, 120px);
    height: auto;
    filter: drop-shadow(0 8px 24px rgba(0, 0, 0, 0.4));
  }

  .performance-metrics__disclaimer {
    font-size: clamp(14px, 1.2vw, 21px);
    color: #ACACAC;
    margin-inline: auto;
    line-height: 1.4;
    padding: 0;
    max-width: 600px;
    width: 100%;
    font-weight: 600;
  }

  @media (max-width: 860px) {
    .performance-metrics {
      min-height: auto;
      padding: clamp(40px, 10vw, 60px) 0;
    }

    .performance-metrics__tiles-wrapper {
      overflow-x: auto;
      overflow-y: hidden;
      -webkit-overflow-scrolling: touch;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      -ms-overflow-style: none;
      margin-left: -16px;
      margin-right: -16px;
      padding: 0 16px;
    }

    .performance-metrics__tiles-wrapper::-webkit-scrollbar {
      display: none;
    }

    .performance-metrics__tiles-grid {
      display: flex;
      flex-wrap: nowrap;
      gap: 12px;
      max-width: none;
      width: max-content;
      padding-right: 16px;
    }

    .performance-metrics__tile {
      flex: 0 0 auto;
      min-width: 140px;
      scroll-snap-align: start;
    }

    .performance-metrics__product {
      margin-top: -40px;
    }
  }
</style>

{% schema %}
{
"name": "Performance Metrics",
"tag": "section",
"class": "section-performance-metrics",
"settings": [
{
"type": "text",
"id": "heading",
"label": "Heading",
"default": "20+ Performance Metrics Tracked"
},
{
"type": "textarea",
"id": "subheading",
"label": "Subheading",
"default": "Track essential ball and club data—ball speed, launch angle, spin, carry, club path, distance, and much
more."
},
{
"type": "image_picker",
"id": "background_image",
"label": "Background Image"
},
{
"type": "checkbox",
"id": "overlaySection",
"label": "Enable Overlay",
"default": false
},
{
"type": "image_picker",
"id": "product_image",
"label": "Product Image"
},
{
"type": "textarea",
"id": "disclaimer",
"label": "Disclaimer Text",
"default": "*Available through the Launch App only and are unique to the Blue Tees Physics Engine"
}
],
"blocks": [
{
"type": "metric_tile",
